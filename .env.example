# --- Telegram ---
# Token que te da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=

# Un secreto cualquiera que vos inventes, para verificar que los webhooks
# de Telegram realmente vienen de Telegram (Header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=cambia-esto-por-algo-secreto

# Tu propio chat_id de Telegram (el admin). Se usa para avisos y para el
# comando /confirmar de respaldo. Lo consigues hablandole a @userinfobot.
ADMIN_CHAT_ID=

# Contraseña para entrar al panel de ventas en https://tu-app.onrender.com/admin
# (el usuario no importa, solo esta contraseña). Invéntate algo largo y random.
ADMIN_PANEL_PASSWORD=

# --- dLocal Go (pagos) ---
# Sacalas del dashboard de dLocal Go: dashboard-sbx.dlocalgo.com (sandbox)
# o dashboard.dlocalgo.com (produccion) -> API Keys
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=
# "sandbox" para probar con tarjetas de prueba, "live" para cobrar de verdad
DLOCAL_ENV=sandbox
PRECIO_MXN=197
PRECIO_TEXTO=$197 MXN

# --- AceDataCloud (Suno) ---
ACEDATACLOUD_API_TOKEN=

# --- Anthropic (Claude) ---
# Usado para redactar la letra y el estilo automaticamente a partir
# de las respuestas del cliente
ANTHROPIC_API_KEY=

# --- General ---
# URL publica de tu servicio en Render, ej: https://cancion-bot.onrender.com
BASE_URL=

# --- Gmail (envio de la cancion por correo, solo para pedidos de la landing web /cancion) ---
# GMAIL_USER: la cuenta desde la que se manda el correo.
# GMAIL_APP_PASSWORD: una "contraseña de aplicacion" (Cuenta de Google ->
# Seguridad -> Verificacion en 2 pasos -> Contraseñas de aplicaciones).
# NO uses tu contraseña normal de Gmail, no va a funcionar.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Intervalo de los loops de fondo (segundos) ---
# Subido temporalmente de 20/30s a 60/90s mientras se diagnostica una fuga
# de memoria en Render. Podes ajustarlo aca sin tocar codigo (ej. a 120 si
# hace falta bajar mas la memoria mientras se arregla de raiz).
POLL_INTERVAL_SECONDS=60
POLL_INTERVAL_STUCK_SECONDS=90

# Horas que se sigue reintentando un pago pendiente antes de darlo por
# abandonado (evita reconsultar para siempre pagos que el cliente nunca
# completo ni cancelo).
PENDING_PAYMENT_MAX_HORAS=48

# --- Meta Pixel / Conversions API (medir conversiones reales de los anuncios) ---
# META_PIXEL_ID: el ID numerico del pixel dedicado a cancion-bot (Events
# Manager -> Configuracion). No es secreto.
# META_CAPI_ACCESS_TOKEN: Events Manager -> Configuracion -> Conversions API
# -> Generar token de acceso. ESTE SI ES SECRETO - nunca lo compartas en
# texto plano, solo pegalo directo aca o en las variables de entorno de Render.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Opcional: codigo de la pestaña "Test Events" en Events Manager, solo
# mientras estas verificando que los eventos lleguen bien.
META_CAPI_TEST_EVENT_CODE=

# --- Google Analytics 4 / Google Ads (medir conversiones de Google Ads) ---
# GA_MEASUREMENT_ID: Admin de GA4 -> Flujos de datos -> tu flujo web ->
# "ID de medicion" (formato "G-XXXXXXXXXX"). No es secreto.
# GOOGLE_ADS_CONVERSION_ID: ID de la cuenta de Google Ads (formato
# "AW-XXXXXXXXXX"), aparece al crear cualquier accion de conversion.
# GOOGLE_ADS_CONVERSION_LABEL: Herramientas -> Conversiones -> tu accion de
# "Compra" -> "Configuracion de la etiqueta" -> el label especifico.
GA_MEASUREMENT_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=

# --- Trustpilot (solo EE.UU. - pedido de reseña al momento de la entrega) ---
# URL de "escribir una reseña" de tu perfil, se consigue al crear la cuenta
# en business.trustpilot.com. No es secreto.
TRUSTPILOT_REVIEW_URL=

# --- PayPal (pagos en USD para EE.UU. - ver app/paypal_client.py) ---
# dLocal Go y Mercado Pago NO pueden cobrarle a alguien fisicamente en
# EE.UU. (solo metodos de pago locales de LatAm) - por eso el trafico en
# ingles usa PayPal en paralelo. Credenciales en developer.paypal.com -> My
# Apps & Credentials (usa las de "Sandbox" para probar primero).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook configurado ahi mismo (Add Webhook, apuntando a
# https://tu-app.onrender.com/paypal/webhook) - necesario para verificar
# que las notificaciones realmente vienen de PayPal.
PAYPAL_WEBHOOK_ID=
# "sandbox" para probar con cuentas de prueba, "live" para cobrar de verdad
PAYPAL_ENV=sandbox

# --- Precios EE.UU. (USD) ---
PRECIO_USD_SONG=27
PRECIO_TEXTO_USD_SONG=$27 USD
PRECIO_USD_VIDEO=49
PRECIO_TEXTO_USD_VIDEO=$49 USD

# Precio de lanzamiento: hasta esta fecha (ISO, con zona horaria) se cobra
# PRECIO_USD_SONG ($27); despues sube automaticamente a PRECIO_USD_SONG_REGULAR.
# ACTUALIZA esto para que coincida con la fecha real en la que arranca la
# campaña de Google Ads - el timer de la landing muestra esta misma fecha.
LAUNCH_PRICE_ENDS_AT=2026-08-30T23:59:59+00:00
PRECIO_USD_SONG_REGULAR=39.90
PRECIO_TEXTO_USD_SONG_REGULAR=$39.90 USD

# --- Upsell de video (Fase 2 - fotos del cliente + cancion = video) ---
# Se deja apagado hasta que el flujo base en ingles (solo cancion) ya este
# vendiendo - ver app/video_client.py.
ENABLE_VIDEO_TIER=false
MEDIA_DIR=/data/media
